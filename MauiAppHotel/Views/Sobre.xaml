<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o App"
             BackgroundColor="#F5F5F5"> <!-- Cor de fundo leve -->

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        
        <!-- Ícone ou Imagem (opcional, pode substituir por uma imagem sua) -->
        <Label Text="🏨" 
               FontSize="60" 
               HorizontalOptions="Center" />

        <!-- Título -->
        <Label Text="Agenda de Hotéis" 
               FontSize="26" 
               FontAttributes="Bold" 
               TextColor="#333333"
               HorizontalOptions="Center" />

        <!-- Separador -->
        <BoxView HeightRequest="2" WidthRequest="100" Color="#0078D7" HorizontalOptions="Center" Margin="0,10" />

        <!-- Informações do Desenvolvedor -->
        <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="20" BackgroundColor="White" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Informações de Desenvolvimento" FontAttributes="Bold" FontSize="16" TextColor="#0078D7" />
                
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Desenvolvedor:" FontAttributes="Bold" />
                    <Label Text="Édipo Henrique" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Ano:" FontAttributes="Bold" />
                    <Label Text="2026" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Instituição:" FontAttributes="Bold" />
                    <Label Text="ETEC" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>
        
    </VerticalStackLayout>
</ContentPage>